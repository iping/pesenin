# Copy to .env for docker compose:
#   cp .env.example .env
#   docker compose up --build
#
# Empty Google / VAPID / R2 values are fine locally: the API enables demo login
# and stores files on disk. Vercel values are documented in DEPLOY-VERCEL.md.
# Do not paste the local values below into the Vercel project as-is.

PUBLIC_ORIGIN=http://localhost:43123
COOKIE_SECURE=false
DEV_LOGIN=true
SEED_DEMO=true
ADMIN_EMAIL=admin@pesenin.test

# Google OAuth. Callback must be {PUBLIC_ORIGIN}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:43123/api/v1/auth/google/callback

# Web Push. Generate with: npx web-push generate-vapid-keys
# If empty, the API writes a dev key pair into the upload volume.
# On Vercel the keys are required; a generated pair would change every cold start.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@pesenin.product.biz.id

# Cloudflare R2 (S3). Leave empty to keep proofs on local disk.
# On Vercel, local disk is ephemeral. Set STORAGE_DRIVER=s3 and the R2 values
# when proofs and product photos must survive a new instance.
STORAGE_DRIVER=local
STORAGE_DIR=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. Session lifetime in days. Sessions are random tokens stored hashed
# in Postgres. There is no separate session-signing secret.
SESSION_DAYS=30

# --- Vercel DEV (set in the project, not used by docker compose) ---
# Neon Marketplace injects the pooled URL and the direct URL. The API uses
# DATABASE_URL at runtime and prefers DATABASE_URL_UNPOOLED for migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require
#
# Stable https origin of the dev deployment (branch alias or custom domain).
# PUBLIC_ORIGIN=https://<dev-host>
# COOKIE_SECURE=true
# DEV_LOGIN=false
# SEED_DEMO=false
# GOOGLE_REDIRECT_URL=https://<dev-host>/api/v1/auth/google/callback
#
# Protects GET/POST /api/v1/internal/tick. Set it if you add a Vercel Schedule
# that runs the worker while the Go instance is scaled to zero.
# CRON_SECRET=
#
# Injected by Vercel Services. Do not set this on Vercel.
# API_INTERNAL_URL=
#
# Docker Compose only. Do not set PORT or HTTP_ADDR on Vercel.
# HTTP_ADDR=:8080
