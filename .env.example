# Copy to .env for docker compose. Empty Google/VAPID/R2 values are fine locally:
# the API enables demo login and stores files on disk.

PUBLIC_ORIGIN=http://localhost:43123
COOKIE_SECURE=false
DEV_LOGIN=true
SEED_DEMO=true
ADMIN_EMAIL=admin@pesenin.test

# Google OAuth. Callback must be {PUBLIC_ORIGIN}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:43123/api/v1/auth/google/callback

# Web Push. Generate with: npx web-push generate-vapid-keys
# If empty, the API writes a dev key pair into the upload volume.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@pesenin.product.biz.id

# Cloudflare R2 (S3). Leave empty to keep proofs on local disk.
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
